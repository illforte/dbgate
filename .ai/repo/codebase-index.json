  "patterns": {
    "workspaceStructure": {
      "description": "Packages follow the root package.json workspace declarations with additional top-level package dirs captured when they act as runtime surfaces.",
      "structure": "packages/*, plugins/*, integration-tests, app, e2e-tests, test-api plus repo-level docs/, docker/, scripts/, and tests/"
    },
    "deployment": {
      "description": "yarn workspace deployment and validation commands",
      "commands": [
        "yarn start"
      ]
    }
  },
  "fileTypes": {
    "workspacePackage": {
      "pattern": "packages/*/package.json, plugins/*/package.json, integration-tests/package.json, app/package.json, e2e-tests/package.json, test-api/package.json",
      "description": "Primary package manifests declared by the root workspace plus extra top-level runtime packages"
    },
    "workerConfig": {
      "pattern": "packages/*/wrangler.toml, plugins/*/wrangler.toml, integration-tests/wrangler.toml, app/wrangler.toml, e2e-tests/wrangler.toml, test-api/wrangler.toml",
      "description": "Cloudflare Worker configuration in workspace packages"
    },
    "repoDocs": {
      "pattern": "docs/**/*.md",
      "description": "Repo-level documentation"
    }
  }
